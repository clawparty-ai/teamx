{
  "name": "@teamx-ai/dsh-plugin",
  "version": "0.2.0",
  "description": "teamx deepseek-harness plugin: multi-agent team collaboration with teamx_* tools, /team-* slash commands, and real-time digest injection",
  "license": "Proprietary",
  "type": "module",
  "main": "lib/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "index.d.ts",
    "README.md"
  ],
  "scripts": {
    "generate:protocols": "node ../scripts/generate-grill-protocol.mjs",
    "check:protocols": "node ../scripts/generate-grill-protocol.mjs --check",
    "build": "npm run generate:protocols && bun build src/index.ts --outfile lib/index.js --external '@deepseek-ai/*' --external 'ws' --format esm --target node",
    "prepack": "npm run build",
    "typecheck": "LOG=$(mktemp -t teamx-dsh-typecheck.XXXXXX.log); command -v tsc >/dev/null 2>&1 || { echo 'typecheck: tsc not found — run npm install (or bun install) in dsh-plugin first' >&2; exit 1; }; tsc --noEmit -p tsconfig.json > $LOG 2>&1; grep -E '^src/' $LOG || true; ! grep -qE '^src/' $LOG"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-commands": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "file:../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "file:../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-agent-loop": "file:../deepseek-harness/packages/core/agent-loop",
    "@deepseek-ai/dsh-session": "file:../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-system-prompt": "file:../deepseek-harness/packages/core/system-prompt",
    "@deepseek-ai/dsh-tools": "file:../deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-commands": "file:../deepseek-harness/packages/interaction/commands",
    "@deepseek-ai/dsh-skill": "file:../deepseek-harness/packages/skill/skill",
    "@deepseek-ai/schemastery": "file:../deepseek-harness/vendor/schemastery",
    "@types/ws": "^8.5.0",
    "typescript": "^5.6.0",
    "zod": "^4.4.3"
  }
}
